# Proof of Build has two apps with their own env files:
#   backend/.env   (copy from backend/.env.example)
#   frontend/.env  (copy from frontend/.env.example)
# This file lists the most important variables of both for quick reference.

# ── Solana ───────────────────────────────────────────────
SOLANA_NETWORK=devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=8GYmgRJ9iRNE9kmBf5HkAfMu23Fdh6ES8XvXMbNdYvJw

# ── Backend (backend/.env) ───────────────────────────────
PORT=3000
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proof_of_build
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/proof_of_build
JWT_SECRET=generate_a_random_string_of_at_least_32_chars
# Oracle keypair: only records fires and attestations, never moves funds.
# Never commit a real key.
ORACLE_SECRET_KEY=your_oracle_secret_key_here
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=generate_a_random_string
GITHUB_ID_SALT=generate_a_random_string
RESEND_API_KEY=

# ── Frontend (frontend/.env) ─────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_RPC_URL=https://api.devnet.solana.com
VITE_DEFAULT_MINT=HncFPHpTBYv4ipiG78HhLZGmGVkZYPxQdsEi17rbVt44
