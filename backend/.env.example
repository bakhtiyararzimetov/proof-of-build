# --- server ---
PORT=3000
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# --- database (Supabase / Neon / local Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proof_of_build
# Supabase: DATABASE_URL = transaction pooler (6543, ?pgbouncer=true), DIRECT_URL = session pooler (5432).
# Locally both can be the same URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/proof_of_build

# --- solana ---
RPC_URL=https://api.devnet.solana.com
# Oracle secret key: JSON array from `solana-keygen new -o oracle.json` or base58. NEVER commit it.
ORACLE_SECRET_KEY=

# --- GitHub App (Settings -> Developer settings -> GitHub Apps) ---
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM contents, newlines as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Salt for github_id_hash (HMAC-SHA256), so GitHub ids cannot be brute-forced from the chain
GITHUB_ID_SALT=

# --- mail (optional: without a key letters are not sent, only hashed and recorded) ---
RESEND_API_KEY=
MAIL_FROM=Proof of Build <onboarding@resend.dev>

# --- anti-fraud thresholds ---
COMMIT_SKEW_HOURS=6
HUGE_COMMIT_LINES=2000
BULK_PUSH_LINES=5000
MIN_FIRE_LINES=3
REQUIRE_VERIFIED_COMMITS=false
NEW_ACCOUNT_DAYS=30
