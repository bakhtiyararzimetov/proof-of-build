{
  "name": "proof-of-build-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync-idl": "cp ../target/idl/proof_of_build.json src/idl/proof_of_build.json && cp ../target/types/proof_of_build.ts src/idl/proof_of_build.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "devnet:setup": "tsx scripts/devnet-setup.ts",
    "set-github-key": "node scripts/set-github-key.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.1.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "resend": "^4.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
